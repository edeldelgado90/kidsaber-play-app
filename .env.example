# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Base URL of the KidSaber questions API.
# Production builds REJECT a non-https value — `expo export` fails outright
# (see src/infrastructure/config/env.ts). Keep http:// for local dev only.
EXPO_PUBLIC_API_URL=http://localhost:8080

# Firebase project configuration (find these in Firebase Console → Project Settings).
# The app signs in anonymously and sends the resulting ID token to the API as
# `Authorization: Bearer <idToken>`. Without these the app runs unauthenticated
# and the API returns 401 when AUTH_ENABLED=true.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_APP_ID=

# reCAPTCHA Enterprise site key backing Firebase App Check on web.
# Create it in Google Cloud Console → Security → reCAPTCHA (type: Website,
# score-based), then register the web app in Firebase Console → App Check.
# Public by design: it only works on the domains you registered with the key.
# Leave empty to disable App Check (the app then sends only the ID token).
# Web only — Android attests via Play Integrity, which needs no site key.
EXPO_PUBLIC_RECAPTCHA_SITE_KEY=

# Optional: support address shown as a mailto link on the "Acerca de" screen
# (/about, reachable from the version line at the bottom of Perfiles).
# Leave empty to hide the contact row entirely.
EXPO_PUBLIC_SUPPORT_EMAIL=

# Optional: Sentry DSN for error monitoring (leave empty in development)
# EXPO_PUBLIC_SENTRY_DSN=

# ── Web deploy (Cloudflare Pages) ─────────────────────────────
# These same EXPO_PUBLIC_* vars must be set in the Cloudflare Pages dashboard
# (Settings → Environment variables) for BOTH Production and Preview, because
# Expo inlines them at build time. See "Deploy web" in README.md.
